---
import Layout from '../../layouts/Layout.astro';

const title = 'Tenda Sanfonada 3x3 ou Pantográfica: Qual Alugar?';
const description = 'Tenda sanfonada 3x3 ou pantográfica: compare as diferenças, prós e contras e descubra qual modelo alugar para o seu evento no Rio de Janeiro.';
const author = 'Equipe Tendas Hoje';
const date = '03 de Agosto de 2026';
const image = '/images/aluguel-de-tendas-sanfonadas.png';

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "image": [image],
  "datePublished": "2026-08-03T08:00:00+08:00",
  "dateModified": "2026-08-03T08:00:00+08:00",
  "author": [{
      "@type": "Person",
      "name": author
  }]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  
