---
// src/components/Pricing.astro

const phoneNumber = "5521976638007";

const models = [
  {
    name: "Tendas Pantográficas",
    imageWebp: "/images/tendas-aluguel-rj.webp",
    image: "/images/tendas-aluguel-rj.png",
    alt: "Tendas pantográficas para eventos no RJ",
    description: "Tendas de alta resistência com estrutura reforçada. Perfeitas para eventos de maior porte e uso prolongado.",
    features: [
      { text: "Estrutura reforçada de alta resistência", included: true },
      { text: "Perfeitas para eventos de grande porte", included: true },
      { text: "Resistentes a sol e chuva", included: true },
      { text: "Montagem e desmontagem inclusas", included: true }
    ],
    cta: "Solicitar Orçamento",
    message: "Olá, gostaria de um orçamento para tendas pantográficas."
  },
  {
    name: "Tenda Piramidal",
    imageWebp: "/images/aluguel-de-barracas-para-feiras-e-eventos.webp",
    image: "/images/aluguel-de-barracas-para-feiras-e-eventos.png",
    alt: "Tenda piramidal para festas e eventos no RJ",
    description: "Cobertura elegante em formato de pirâmide, ideal para feiras, estandes e eventos que precisam de destaque.",
    features: [
      { text: "Formato piramidal elegante", included: true },
      { text: "Ideal para feiras e estandes", included: true },
      { text: "Montagem rápida e fácil", included: true },
      { text: "Diversos tamanhos disponíveis", included: true }
    ],
    cta: "Solicitar Orçamento",
    message: "Olá, gostaria de um orçamento para tenda piramidal."
  },
  {
    name: "Lonas Tipo Circo",
    imageWebp: "/images/lona-de-circo-rj.webp",
    image: "/images/lona-de-circo-rj.png",
    alt: "Lona tipo circo para eventos no RJ",
    description: "Lonas de grande cobertura no estilo circo, perfeitas para eventos amplos com muita proteção e visual marcante.",
    features: [
      { text: "Grande área de cobertura", included: true },
      { text: "Visual marcante estilo circo", included: true },
      { text: "Ideal para eventos amplos", included: true },
      { text: "Proteção contra sol e chuva", included: true }
    ],
    cta: "Solicitar Orçamento",
    message: "Olá, gostaria de um orçamento para lona tipo circo."
  }
];
---

<section class="pricing-section" id="modelos">
  <div class="pricing-container">
    <div class="pricing-header fade-up">
      <span class="label">NOSSOS MODELOS</span>
      <h2>Escolha o Modelo Ideal para Seu Evento</h2>
      <p>Tendas pantográficas, piramidais e lonas tipo circo para todos os tipos de eventos no Rio de Janeiro.</p>
    </div>

    <div class="pricing-grid">
      {models.map((model, index) => (
        <div
          class="pricing-card fade-up"
          style={`--delay: ${index * 0.15}s`}
        >
          <div class="card-image">
            <picture>
              <source srcset={model.imageWebp} type="image/webp" />
              <img
                src={model.image}
                alt={model.alt}
                loading="lazy"
                decoding="async"
                width="600"
                height="400"
              />
            </picture>
          </div>

          <div class="card-header">
            <h3>{model.name}</h3>
            <p class="description">{model.description}</p>
          </div>

          <div class="card-body">
            <ul class="features-list">
              {model.features.map(feature => (
                <li class={feature.included ? 'included' : 'excluded'}>
                  <svg class="icon check" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>{feature.text}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="card-footer">
            <a
              href={`https://wa.me/${phoneNumber}?text=${encodeURIComponent(model.message)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-btn"
            >
              {model.cta}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: #F8FAFC;
    padding: 5rem 1rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  }

  .pricing-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 700;
    color: #F59E0B;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    background: rgba(245, 158, 11, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
  }

  .pricing-header h2 {
    font-size: 2.5rem;
    color: #0F172A;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .pricing-header p {
    font-size: 1.125rem;
    color: #64748B;
    max-width: 600px;
    margin: 0 auto;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .pricing-card {
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(15, 23, 42, 0.1);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }

  .pricing-card:hover {
    border-color: #F59E0B;
    box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.2), 0 8px 10px -6px rgba(245, 158, 11, 0.1);
    transform: translateY(-5px);
  }

  .card-image {
    margin: -1.5rem -1.5rem 1.5rem;
    height: 200px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .pricing-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-header {
    text-align: center;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
    padding-bottom: 1.5rem;
  }

  .card-header h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: #0F172A;
  }

  .description {
    font-size: 0.9375rem;
    margin-bottom: 0;
    color: #64748B;
    line-height: 1.6;
  }

  .card-body {
    flex-grow: 1;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .features-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #334155;
  }

  .features-list li.excluded {
    opacity: 0.5;
  }

  .icon {
    flex-shrink: 0;
  }

  .icon.check {
    color: #25D366;
  }

  .card-footer {
    margin-top: 2rem;
  }

  .cta-btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 1rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 1rem;
    background: #F1F5F9;
    color: #0F172A;
  }

  .cta-btn:hover {
    background: #E2E8F0;
    color: #F59E0B;
  }

  /* Animation Styles */
  .fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    transition-delay: var(--delay, 0s);
  }

  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const elementsToAnimate = document.querySelectorAll('.fade-up');
    elementsToAnimate.forEach(el => observer.observe(el));
  });
</script>
