const description = 'Saiba quando usar fechamento lateral em tendas e quais as vantagens para eventos no RJ: proteção contra vento, privacidade e controle de acesso. Consulte modelos disponíveis.';
const author = 'Equipe Tendas Hoje';
const date = '10 de Agosto de 2026';
const image = '/images/aluguel-de-tendas-com-fechamento-lateral-no-rj.png';

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "image": [image],
